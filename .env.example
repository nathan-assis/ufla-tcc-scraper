# Exemplo de variáveis de ambiente
# Copie para .env e ajuste conforme necessário

# Logging
LOG_LEVEL=INFO

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph defaults
DEFAULT_SIMILARITY_THRESHOLD=0.75
DEFAULT_KNN_K=3
DEFAULT_KNN_SYMMETRIC_K=4

# URLs
SIP_BASE_URL=https://sip.prg.ufla.br/publico/trabalhos_conclusao_curso/acessar_tcc_por_curso/